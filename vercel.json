{
  "version": 2,
  "builds": [
    {
      "src": "blog/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "out"
      }
    },
    {
      "src": "index.html",
      "use": "@vercel/static"
    },
    {
      "src": "assets/**/*",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    { "src": "/blog/(.*)", "dest": "/blog/out/$1" },
    { "src": "/apresentacoes", "dest": "/apresentacoes.html" },
    { "src": "/portal", "dest": "/portal.html" },
    { "src": "/(.*\\.(css|js|jpg|png|gif|ico|svg|html))", "dest": "/$1" },
    { "src": "/", "dest": "/index.html" }
  ]
}
