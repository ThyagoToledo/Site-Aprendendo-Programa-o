{
  "version": 2,
  "builds": [
    {
      "src": "blog/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "out"
      }
    }
  ],
  "routes": [
    {
      "src": "/blog/(.*)",
      "dest": "/blog/$1"
    },
    {
      "src": "/(.*\\.(css|js|jpg|png|gif|ico|svg|html))",
      "dest": "/$1"
    },
    {
      "src": "/",
      "dest": "/index.html"
    },
    {
      "src": "/apresentacoes",
      "dest": "/apresentacoes.html"
    },
    {
      "src": "/portal",
      "dest": "/portal.html"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
